{
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@json/*": ["json/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "json"],
  "exclude": ["node_modules", "dist", "demo", "build"]
}
